{
  "$schema" : "https://vega.github.io/schema/vega-lite/v5.json",
  "data" : {
    "format" : {
      "property" : "rows",
      "type" : "json"
    },
    "url" : "data/latest.json"
  },
  "description" : "Negative values indicate traffic below the same calendar-day median across prior available years.",
  "facet" : {
    "row" : {
      "field" : "port-name",
      "header" : {
        "labelAngle" : 0,
        "title" : null
      },
      "type" : "nominal"
    }
  },
  "spec" : {
    "height" : 150,
    "layer" : [ {
      "encoding" : {
        "y" : {
          "datum" : 0
        }
      },
      "mark" : {
        "type" : "rule"
      }
    }, {
      "encoding" : {
        "tooltip" : [ {
          "field" : "date",
          "type" : "temporal"
        }, {
          "field" : "vessels-total",
          "type" : "quantitative"
        }, {
          "field" : "baseline-median",
          "type" : "quantitative"
        }, {
          "field" : "deviation-percent",
          "format" : ".1f",
          "type" : "quantitative"
        } ],
        "x" : {
          "field" : "date",
          "title" : null,
          "type" : "temporal"
        },
        "y" : {
          "field" : "deviation-percent",
          "title" : "% vs prior-year median",
          "type" : "quantitative"
        }
      },
      "mark" : {
        "type" : "line"
      }
    } ],
    "width" : 760
  },
  "title" : "Visible passage deviation from observed prior-year median",
  "transform" : [ {
    "filter" : "isValid(datum['deviation-percent'])"
  } ]
}
